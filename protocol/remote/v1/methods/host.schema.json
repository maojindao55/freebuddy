{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freebuddy.dev/protocol/remote/v1/methods/host.schema.json",
  "title": "host/sync/project/agent method params and results",
  "$defs": {
    "host.status.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "host.status.result": {
      "$ref": "https://freebuddy.dev/protocol/remote/v1/common.schema.json#/$defs/HostStatus"
    },
    "sync.snapshot.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversationLimit": { "$ref": "https://freebuddy.dev/protocol/remote/v1/common.schema.json#/$defs/Limit" }
      }
    },
    "sync.snapshot.result": {
      "$ref": "https://freebuddy.dev/protocol/remote/v1/common.schema.json#/$defs/SnapshotPayload"
    },
    "project.list.params": {
      "$ref": "https://freebuddy.dev/protocol/remote/v1/common.schema.json#/$defs/PageParams"
    },
    "project.list.result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "https://freebuddy.dev/protocol/remote/v1/common.schema.json#/$defs/ProjectSummary" }
        },
        "nextCursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "agent.list.params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectId": { "$ref": "https://freebuddy.dev/protocol/remote/v1/common.schema.json#/$defs/RemoteId" },
        "cursor": { "$ref": "https://freebuddy.dev/protocol/remote/v1/common.schema.json#/$defs/Cursor" },
        "limit": { "$ref": "https://freebuddy.dev/protocol/remote/v1/common.schema.json#/$defs/Limit" }
      }
    },
    "agent.list.result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "https://freebuddy.dev/protocol/remote/v1/common.schema.json#/$defs/AgentSummary" }
        },
        "nextCursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
