{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FreeBuddy freebie provider catalog",
  "type": "object",
  "required": ["providers"],
  "properties": {
    "$schema": { "type": "string" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "providers": {
      "type": "array",
      "items": { "$ref": "#/$defs/provider" }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "required": ["id", "name", "protocol", "baseUrl", "models"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "region": { "enum": ["cn", "global"] },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
        "consoleUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "freeTierSummary": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 400 }
        },
        "protocol": { "enum": ["openai-chat", "openai-responses", "anthropic", "deepseek"] },
        "baseUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "envKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "name": { "type": "string", "maxLength": 80 },
              "contextWindow": { "type": "integer", "minimum": 1 },
              "supportsVision": { "type": "boolean" }
            }
          }
        },
        "contextWindow": { "type": "integer", "minimum": 1 },
        "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
