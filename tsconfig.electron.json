{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "types": ["node"]
  },
  "include": ["electron/main.ts", "electron/menu.ts", "electron/app-meta.ts", "electron/butlerBuddyState.ts", "electron/cli/**/*.ts", "electron/games/**/*.ts", "electron/mcp/**/*.ts", "electron/remote/**/*.ts", "electron/runtime/**/*.ts", "electron/shared/**/*.ts"]
}
